# Salin file ini menjadi .Renviron (di folder yang sama), isi, lalu mulai ulang R.
# File .Renviron TIDAK ikut ke GitHub.
ANTHROPIC_API_KEY=
ZI_TAHUN=2026
ZI_UNIT=Fakultas Kedokteran Universitas Hasanuddin
# Opsional - tampil di bilah info paling atas:
# ZI_ALAMAT=Alamat fakultas
# ZI_EMAIL=email@fakultas
# Opsional:
# ZI_CLAUDE_MODEL=claude-opus-5-5
# ZI_CLAUDE_EFFORT=medium
# Menu Pengaturan disembunyikan secara bawaan. Isi "ya" hanya di komputer Admin:
# ZI_MENU_PENGATURAN=tidak
# Teks nama unit di atas banner: otomatis (hanya pada banner bawaan) / ya / tidak
# ZI_TEKS_BANNER=otomatis
